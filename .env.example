# Hygraph Content API endpoint (was NEXT_PUBLIC_GRAPHCMS_KEY, which is still read as a fallback)
HYGRAPH_ENDPOINT=
# Optional: permanent auth token with draft access, if the content API isn't public
HYGRAPH_TOKEN=
# Shared secret for /api/draft?secret=… (preview links in Hygraph)
GRAPHCMS_PREVIEW_SECRET=
# Shared secret for the Hygraph publish webhook → POST /api/revalidate
HYGRAPH_REVALIDATE_SECRET=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
